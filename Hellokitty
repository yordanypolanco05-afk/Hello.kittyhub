local function createTab(tabName: string, index: number)
	local TabBtn = Instance.new("TextButton")
	TabBtn.Name, TabBtn.Size, TabBtn.BackgroundColor3 = tabName .. "TabBtn", UDim2.new(0, 72, 0, 24), Color3.fromRGB(18, 18, 22)
	TabBtn.Text, TabBtn.TextColor3, TabBtn.TextSize, TabBtn.Font, TabBtn.AutoButtonColor, TabBtn.LayoutOrder, TabBtn.Parent = tabName, Color3.fromRGB(150, 150, 155), isMobile and 7 or 9, Enum.Font.GothamMedium, false, index, TabBarContainer
	Corner(TabBtn, 6)
	local BtnStroke = Stroke(TabBtn, 1, 0.6)

	local ContentScroll = Instance.new("ScrollingFrame")
	ContentScroll.Name, ContentScroll.Size, ContentScroll.BackgroundTransparency, ContentScroll.Visible, ContentScroll.ScrollBarThickness, ContentScroll.ScrollBarImageColor3, ContentScroll.Parent = tabName .. "Content", UDim2.new(1, 0, 1, 0), 1, false, 2, Color3.fromRGB(255, 105, 180), ContainerArea
	local ContentLayout = Instance.new("UIListLayout")
	ContentLayout.SortOrder, ContentLayout.Padding, ContentLayout.Parent = Enum.SortOrder.LayoutOrder, UDim.new(0, 6), ContentScroll

	tabFrames[tabName] = ContentScroll
	tabButtons[tabName] = {Btn = TabBtn, Stroke = BtnStroke}

	TabBtn.MouseButton1Click:Connect(function()
		PlaySound(SOUND_CLICK)
		for name, data in pairs(tabButtons) do
			if name == tabName then
				Tween(data.Btn, 0.2, { BackgroundColor3 = Color3.fromRGB(28, 28, 35), TextColor3 = Color3.fromRGB(255, 255, 255) })
				Tween(data.Stroke, 0.2, { Transparency = 0.2, Color = Color3.fromRGB(255, 105, 180) })
				tabFrames[name].Visible = true
			else
				Tween(data.Btn, 0.2, { BackgroundColor3 = Color3.fromRGB(18, 18, 22), TextColor3 = Color3.fromRGB(150, 150, 155) })
				Tween(data.Stroke, 0.2, { Transparency = 0.6, Color = Color3.fromRGB(255, 255, 255) })
				tabFrames[name].Visible = false
