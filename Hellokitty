local function createTab(tabName: string, index: number)
	local TabBtn = Instance.new("TextButton")
	TabBtn.Name, TabBtn.Size, TabBtn.BackgroundColor3 = tabName .. "TabBtn", UDim2.new(0, 52, 0, 24), Color3.fromRGB(16, 16, 20)
