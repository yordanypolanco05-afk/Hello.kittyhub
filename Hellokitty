local function GlassBreakClose(targetFrame: Frame, callback: () -> ())
	PlaySound(SOUND_GLASS_BREAK)
	PlaySound(SOUND_CLICK)
	local originalPos = targetFrame.Position
	for i = 1, 4 do
		targetFrame.Position = originalPos + UDim2.new(0, math.random(-6, 6), 0, math.random(-6, 6))
		task.wait(0.03)
	end
	targetFrame.Position = originalPos
	local closeTween = Tween(targetFrame, 0.15, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	closeTween.Completed:Connect(function() if callback then callback() end end)
end

