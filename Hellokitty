				local targetPos = mouse.Hit.Position + Vector3.new(0, 3, 0)
				Tween(hrp, 0.06, {CFrame = CFrame.new(targetPos)}, Enum.EasingStyle.Linear)
				ShowNotification("ClickTP", "Teleported!", Color3.fromRGB(0, 255, 127))
			end
		end)
		tool.Parent = backpack
		ShowNotification("Inventory", "ClickTP Tool añadido a la mochila", Color3.fromRGB(0, 255, 127))
	end
end)

