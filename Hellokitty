		Card.Position = UDim2.new(1, 40, Card.Position.Scale, Card.Position.Offset)
		Tween(Card, 0.25, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		
		task.wait(2)
		Tween(Card, 0.2, {Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
