	task.spawn(function()
		local Card = Instance.new("Frame")
		Card.Size, Card.BackgroundColor3, Card.BackgroundTransparency, Card.BorderSizePixel = UDim2.new(1, 0, 0, 36), Color3.fromRGB(18, 18, 24), 0.1, 0
