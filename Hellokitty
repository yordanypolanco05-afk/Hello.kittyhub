RunService.RenderStepped:Connect(function()
	if isMobile then FOFCircle.Position = UDim2.fromScale(0.5, 0.5) else local mousePos = UserInputService:GetMouseLocation() FOFCircle.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y) end
	if not aimlockActive or aimlockPaused then activeAimTarget = nil return end
	
	local referencePos = isMobile and Camera.ViewportSize / 2 or UserInputService:GetMouseLocation()
	local closestTarget, shortestDist = nil, fovRadius
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local hrp = player.Character.HumanoidRootPart
				local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - referencePos).Magnitude
					if dist < shortestDist then
						local raycastParams = RaycastParams.new()
						raycastParams.FilterType = Enum.RaycastFilterType.Exclude
						raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
						local result = workspace:Raycast(Camera.CFrame.Position, (hrp.Position - Camera.CFrame.Position), raycastParams)
						if not result or result.Instance:IsDescendantOf(player.Character) then
							shortestDist, closestTarget = dist, hrp
						end
					end
				end
			end
		end
	end
	
	activeAimTarget = closestTarget
	if closestTarget then 
		Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closestTarget.Position), 0.15) 
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position, Vector3.new(closestTarget.Position.X, LocalPlayer.Character.HumanoidRootPart.Position.Y, closestTarget.Position.Z))
		end
	end
end)

