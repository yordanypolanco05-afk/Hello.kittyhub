local function PlaySound(id: number)
	if id == 0 then return end
	task.spawn(function()
		pcall(function()
			local sound = Instance.new("Sound")
			sound.SoundId = "rbxassetid://" .. tostring(id)
			sound.Volume = 0.6
			sound.Parent = SoundService
			sound:Play()
			sound.Ended:Connect(function() sound:Destroy() end)
		end)
	end)
end

