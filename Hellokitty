local activeNotifications = 0
local MAX_NOTIFICATIONS = 3 -- Límite estricto para evitar saturación visual

local function ShowNotification(title: string, text: string, color: Color3?)
	if activeNotifications >= MAX_NOTIFICATIONS then return end
	activeNotifications += 1

	task.spawn(function()
		local Card = Instance.new("Frame")
		Card.Size, Card.BackgroundColor3, Card.BackgroundTransparency, Card.BorderSizePixel = UDim2.new(1, 0, 0, 28), Color3.fromRGB(14, 14, 18), 0.1, 0
		Card.Parent = NotificationContainer
		Corner(Card, 5)
		local stroke = Stroke(Card, 1, 0.4)
		stroke.Color = color or Color3.fromRGB(255, 105, 180)

		local TLab = Instance.new("TextLabel")
		TLab.Size, TLab.Position, TLab.BackgroundTransparency, TLab.Font, TLab.TextColor3, TLab.TextSize, TLab.TextXAlignment, TLab.Text, TLab.Parent = UDim2.new(0.7, 0, 1, 0), UDim2.new(0, 6, 0, 0), 1, Enum.Font.GothamBold, color or Color3.fromRGB(255, 175, 200), 9, Enum.TextXAlignment.Left, title .. ": " .. text, Card

		-- Contador diminuto de duración en tiempo real dentro del mensaje
		local TimerLab = Instance.new("TextLabel")
		TimerLab.Size, TimerLab.Position, TimerLab.BackgroundTransparency, TimerLab.Font, TimerLab.TextColor3, TimerLab.TextSize, TimerLab.TextXAlignment, TimerLab.Text, TimerLab.Parent = UDim2.new(0.3, 0, 1, 0), UDim2.new(0.7, -4, 0, 0), 1, Enum.Font.Code, Color3.fromRGB(150, 150, 160), 8, Enum.TextXAlignment.Right, "0.6s", Card

		Card.Position = UDim2.new(1, 40, Card.Position.Scale, Card.Position.Offset)
		Tween(Card, 0.15, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

		local duration = 0.6
		local elapsed = 0
		while elapsed < duration do
			local dt = task.wait(0.05)
			elapsed += dt
			local remaining = math.clamp(duration - elapsed, 0, duration)
			TimerLab.Text = string.format("%.1fs", remaining)
		end

		Tween(Card, 0.12, {Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		task.wait(0.12)
		Card:Destroy()
		activeNotifications = math.max(0, activeNotifications - 1)
	end)
end

