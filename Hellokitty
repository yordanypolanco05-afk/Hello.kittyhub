	Corner(TabBtn, 5)
	
	local TabStroke = Stroke(TabBtn, 1, 0.7)
	TabStroke.Color = Color3.fromRGB(255, 255, 255)

	local ContentScroll = Instance.new("ScrollingFrame")
	ContentScroll.Name, ContentScroll.Size, ContentScroll.BackgroundTransparency, ContentScroll.Visible, ContentScroll.ScrollBarThickness, ContentScroll.ScrollBarImageColor3, ContentScroll.Parent = tabName .. "Content", UDim2.new(1, 0, 1, 0), 1, false, 2, Color3.fromRGB(255, 105, 180), ContainerArea
	local ContentLayout = Instance.new("UIListLayout")
	ContentLayout.SortOrder, ContentLayout.Padding, ContentLayout.Parent = Enum.SortOrder.LayoutOrder, UDim.new(0, 6), ContentScroll

	tabFrames[tabName] = ContentScroll
	tabButtons[tabName] = {Btn = TabBtn, Stroke = TabStroke}

	TabBtn.MouseEnter:Connect(function()
		if tabFrames[tabName].Visible then return end
		Tween(TabBtn, 0.15, {Position = TabBtn.Position - UDim2.new(0, 0, 0, 2), BackgroundColor3 = Color3.fromRGB(24, 24, 32)})
		Tween(TabStroke, 0.15, {Transparency = 0.3})
	end)

	TabBtn.MouseLeave:Connect(function()
		if tabFrames[tabName].Visible then return end
		Tween(TabBtn, 0.15, {Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(16, 16, 20)})
